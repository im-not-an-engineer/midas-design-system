{
  "name": "@ax/tokens",
  "version": "0.1.0",
  "description": "AX 디자인시스템 토큰 — 3계층 구조, 2층이 테마-컴포넌트 계약. 프레임워크 무관(CSS 변수 + JSON).",
  "type": "module",
  "files": ["dist", "src"],
