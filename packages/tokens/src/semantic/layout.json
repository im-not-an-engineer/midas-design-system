    },
    "raised": {
      "$value": "{scale.shadow.sm}",
      "$description": "카드"
    },
    "overlay": {
      "$value": "{scale.shadow.md}",
      "$description": "팝오버·드롭다운"
    },
    "modal": {
      "$value": "{scale.shadow.lg}",
      "$description": "다이얼로그"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{scale.duration.fast}"
      },
      "normal": {
        "$value": "{scale.duration.normal}"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{scale.easing.standard}"
      },
      "exit": {
        "$value": "{scale.easing.exit}"
      }
    }
