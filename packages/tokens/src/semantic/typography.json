{
  "$description": "2층 Semantic — 타이포 계약. 역할 이름만 있고 px는 없다. 아키타입이 body 크기를 통째로 내리면 화면 밀도가 따라 내려간다.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "{scale.fontFamily.systemSans}"
      },
      "mono": {
        "$value": "{scale.fontFamily.systemMono}"
      }
    },
    "size": {
      "$type": "dimension",
      "footnote": {
        "$value": "{scale.fontSize.11}",
        "$description": "caption 아래 한 단계. 입력칸 아래 설명·에러처럼 레이블보다 낮은 글자."
      },
      "caption": {
        "$value": "{scale.fontSize.12}",
        "$description": "보조 설명, 헬프 텍스트"
      },
      "body": {
        "$value": "{scale.fontSize.14}",
        "$description": "기본 본문. 밀도의 기준점."
      },
      "bodyLg": {
        "$value": "{scale.fontSize.16}"
      },
      "content": {
        "$value": "{scale.fontSize.14}",
        "$description": "읽는 글자 — 표 셀·본문 문단. body 는 버튼·입력칸 같은 UI 글자라 workbench 가 13 으로 조이지만, 읽는 글자는 14 아래로 내리지 않는다. 본문 사다리(caption·body·bodyLg)와 따로 논다."
      },
      "headingXs": {
        "$value": "{scale.fontSize.14}",
        "$description": "제목 사다리의 최하단. 본문보다 한 톤 크지만 제목 대접은 덜 받는 자리 — 탭 이름, 아코디언 질문처럼 줄 안에 서는 제목이다. 본문 사다리(caption·body·bodyLg) 사이에는 끼울 수 없었다: 기본 계약은 14<?<16, consumer 는 16<?<18 이라 척도에 들어갈 값이 없다."
      },
      "headingSm": {
        "$value": "{scale.fontSize.16}"
      },
      "headingMd": {
        "$value": "{scale.fontSize.20}"
      },
      "headingLg": {
        "$value": "{scale.fontSize.24}"
      },
      "display": {
        "$value": "{scale.fontSize.30}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": "{scale.fontWeight.regular}"
      },
      "medium": {
        "$value": "{scale.fontWeight.medium}"
      },
      "semibold": {
        "$value": "{scale.fontWeight.semibold}"
      },
      "bold": {
        "$value": "{scale.fontWeight.bold}",
        "$description": "버튼처럼 눌러야 하는 것의 글자. semibold(제목)보다 한 단계 위다."
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": "{scale.lineHeight.tight}",
        "$description": "제목"
      },
      "normal": {
        "$value": "{scale.lineHeight.normal}",
        "$description": "본문"
      },
      "ui": {
        "$value": "{scale.lineHeight.snug}",
        "$description": "컨트롤 안 한 줄 텍스트"
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "heading": {
        "$value": "{scale.letterSpacing.tight}"
      },
      "body": {
        "$value": "{scale.letterSpacing.normal}"
      }
    }
  }
