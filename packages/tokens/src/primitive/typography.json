{
  "$description": "1층 Primitive — 타이포 재료.",
  "scale": {
    "fontSize": {
      "$type": "dimension",
      "11": { "$value": "11px" },
      "12": { "$value": "12px" },
      "13": { "$value": "13px" },
      "14": { "$value": "14px" },
      "16": { "$value": "16px" },
      "18": { "$value": "18px" },
      "20": { "$value": "20px" },
      "24": { "$value": "24px" },
      "30": { "$value": "30px" },
      "36": { "$value": "36px" }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "tight":   { "$value": 1.2 },
      "snug":    { "$value": 1.35 },
      "normal":  { "$value": 1.5 },
      "relaxed": { "$value": 1.7 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.01em" },
      "normal": { "$value": "0em" },
      "wide":   { "$value": "0.02em" }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "systemSans": { "$value": ["Pretendard", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "sans-serif"] },
      "systemMono": { "$value": ["ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "Consolas", "monospace"] }
    }
  }
}
